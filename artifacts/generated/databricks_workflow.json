{
  "name": "NIGHTLY_ACCOUNT_POSTING",
  "job_cluster": {
    "job_cluster_key": "mf_cluster",
    "new_cluster": {
      "spark_version": "15.4.x-scala2.12",
      "node_type_id": "i3.xlarge",
      "num_workers": 2,
      "spark_conf": {
        "spark.sql.parquet.compression.codec": "snappy"
      }
    }
  },
  "tasks": [
    {
      "task_key": "sort_transactions",
      "description": "STEP010 EXEC PGM=SORT -> orderBy(ACCT_NO) -> sorted staging",
      "job_cluster_key": "mf_cluster",
      "notebook_task": {
        "notebook_path": "/Users/memo/mainframe/sort_transactions",
        "source": "WORKSPACE"
      },
      "depends_on": []
    },
    {
      "task_key": "post_transactions",
      "description": "STEP020 EXEC PGM=ACCTPOST -> apply CR/DR + overdraft + interest (MERGE)",
      "job_cluster_key": "mf_cluster",
      "notebook_task": {
        "notebook_path": "/Users/memo/mainframe/post_transactions",
        "source": "WORKSPACE"
      },
      "depends_on": [
        {
          "task_key": "sort_transactions"
        }
      ]
    },
    {
      "task_key": "backup_vsam",
      "description": "STEP030 EXEC PGM=IDCAMS -> Delta table copy / time-travel backup",
      "job_cluster_key": "mf_cluster",
      "notebook_task": {
        "notebook_path": "/Users/memo/mainframe/backup_vsam",
        "source": "WORKSPACE"
      },
      "depends_on": [
        {
          "task_key": "post_transactions"
        }
      ]
    },
    {
      "task_key": "build_report",
      "description": "STEP040 EXEC PGM=ACCTRPT -> aggregate report -> Gold table",
      "job_cluster_key": "mf_cluster",
      "notebook_task": {
        "notebook_path": "/Users/memo/mainframe/build_report",
        "source": "WORKSPACE"
      },
      "depends_on": [
        {
          "task_key": "backup_vsam"
        }
      ]
    }
  ],
  "parameters": [
    {
      "name": "JOB_NAME",
      "default": "NIGHTLY"
    },
    {
      "name": "INTEREST_RATE",
      "default": "0.05"
    }
  ],
  "tags": {
    "poc": "mainframe-to-databricks"
  }
}